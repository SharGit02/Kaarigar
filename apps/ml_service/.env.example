# apps/ml_service — Python ML microservice env vars (set these on Render, not
# in Vercel). Copy to `.env` for local runs (`uvicorn` doesn't auto-load env
# files — use `uvicorn app.main:app --reload --port 8000 --env-file .env`,
# or export these in your shell).

# Shared secret with apps/web (ML_SERVICE_API_KEY there). Requests to
# /price/predict and /asr are rejected with 401 unless this header matches:
#   x-internal-api-key: <this value>
# Leave blank for local dev to skip the check entirely.
ML_SERVICE_API_KEY=

# Optional ASR fallback tier — see README.md "Enabling /asr". Leave unset to
# keep /asr returning 503 (the Next.js app then skips to the browser's own
# Web Speech API).
ASR_MODEL_ID=
