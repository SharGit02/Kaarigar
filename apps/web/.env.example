# Copy this file to .env.local and fill in what you have. Every third-party
# key is optional — the app boots and runs with all of them blank, and each
# integration degrades to a documented fallback (see src/config/env.ts).

NEXT_PUBLIC_APP_URL="http://localhost:3000"

# --- Database (Neon Postgres) ---
# Create a project at https://neon.tech, or run the `neon` skill / `npx neon-new`
# for a throwaway instance if you just want to try the app.
DATABASE_URL=

# --- Auth (JWT signing secrets) ---
# Leave blank in development — env.ts generates an ephemeral secret and warns
# in the console. REQUIRED in production. Generate one with:
#   node -e "console.log(require('crypto').randomBytes(48).toString('hex'))"
JWT_ACCESS_SECRET=
JWT_REFRESH_SECRET=

# --- Renflair WhatsApp (OTP delivery — primary + fallbacks) ---
# Sends OTP via WhatsApp. When key #1 is exhausted, keys #2–#6 are tried in order.
# Template files for extra keys: env/renflair/key-*.env.example
RENFLAIR_WHATSAPP_API_KEY=
RENFLAIR_WHATSAPP_API_KEY_2=
RENFLAIR_WHATSAPP_API_KEY_3=
RENFLAIR_WHATSAPP_API_KEY_4=
RENFLAIR_WHATSAPP_API_KEY_5=
RENFLAIR_WHATSAPP_API_KEY_6=

# --- Twilio SMS (OTP — optional fallback) ---
# Used in both development and production when all three are set.
# From https://console.twilio.com — Account SID, Auth Token, and a Twilio phone number.
# Aliases also accepted: TWILIO_SID (account SID), TWILIO_CLIENT_SECRET (auth token).
# Trial accounts can only SMS verified recipient numbers — add them under Phone Numbers > Verified Caller IDs.
# For India (+91): enable India under Messaging → Settings → Geo Permissions in Twilio Console.
TWILIO_ACCOUNT_SID=
TWILIO_AUTH_TOKEN=
TWILIO_PHONE_NUMBER=
# Optional — use instead of TWILIO_PHONE_NUMBER when you have a Messaging Service configured.
TWILIO_MESSAGING_SERVICE_SID=

# --- Sarvam AI (primary speech-to-text + translation) ---
# https://docs.sarvam.ai — without this, the pipeline falls through to the
# Python ML service below, then to the browser's Web Speech API.
SARVAM_API_KEY=

# --- Python ML microservice (apps/ml_service/) ---
# ASR fallback (AI4Bharat) + the sklearn dynamic-pricing model. Deployed
# separately (Render, a HF Space, etc.) — see apps/ml_service/README.md. Leave
# blank to skip the ASR fallback tier and use the deterministic pricing
# rules engine instead of the ML model.
ML_SERVICE_URL=
ML_SERVICE_TIMEOUT_MS=8000
# Shared secret with apps/ml_service — must match ML_SERVICE_API_KEY there.
# Leave both blank in local dev; set both once the ML service is deployed
# and reachable from the internet.
ML_SERVICE_API_KEY=

# --- Gemini ---
# Powers structured extraction from voice transcripts (business/product
# drafts) and pricing-rationale refinement. Without it, both fall back to
# deterministic, offline logic (keyword matching / the rules engine).
# Get a key at https://aistudio.google.com/apikey
GEMINI_API_KEY=

# --- Cloudinary (photo storage + AI image enhancement) ---
# Without these, photo upload is disabled (onboarding/product-photo/avatar
# steps show a clear "not configured" state rather than failing silently).
# Get credentials from your Cloudinary dashboard.
CLOUDINARY_CLOUD_NAME=
CLOUDINARY_API_KEY=
CLOUDINARY_API_SECRET=

# --- Razorpay (advance payments) ---
# Without these, "Pay advance" shows a clear "payments aren't set up yet"
# message instead of attempting checkout. RAZORPAY_WEBHOOK_SECRET is
# configured separately in the Razorpay dashboard's webhook settings — it is
# NOT the same secret as RAZORPAY_KEY_SECRET.
RAZORPAY_KEY_ID=
RAZORPAY_KEY_SECRET=
RAZORPAY_WEBHOOK_SECRET=
NEXT_PUBLIC_RAZORPAY_KEY_ID=

# --- Pusher Channels (real-time chat) ---
# Messages are always persisted to Postgres; Pusher is purely the live-notify
# side-channel that pushes a new message to the other party instantly instead
# of waiting for the next poll. Without these, chat falls back to polling
# every few seconds — still fully functional, just not instant.
# Get credentials from https://dashboard.pusher.com (Channels app).
PUSHER_APP_ID=
PUSHER_KEY=
PUSHER_SECRET=
PUSHER_CLUSTER=
NEXT_PUBLIC_PUSHER_KEY=
NEXT_PUBLIC_PUSHER_CLUSTER=

# --- ElevenLabs (onboarding voice narration) ---
# Powers spoken prompts during the conversational onboarding flow. Without a
# key, prompts still play — via the browser's built-in speechSynthesis
# instead. Every prompt is a fixed, short piece of script text; the first
# time each one is requested it's synthesized once and cached permanently in
# Cloudinary (requires Cloudinary to also be configured), so no repeat API
# calls happen across users or sessions.
# Get a key at https://elevenlabs.io
ELEVENLABS_API_KEY=
ELEVENLABS_VOICE_ID=21m00Tcm4TlvDq8ikWAM

# --- OAuth login (Google / GitHub) ---
# Additive to phone/OTP, not a replacement — phone stays the primary login
# option on the page. Without these, the buttons still render but redirect
# straight back with a clear "not set up yet" message.
#
# Google: https://console.cloud.google.com/apis/credentials
#   -> Create Credentials -> OAuth client ID -> Web application
#   Authorized redirect URI: {NEXT_PUBLIC_APP_URL}/api/auth/oauth/google/callback
#     e.g. http://localhost:3000/api/auth/oauth/google/callback for local dev
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
#
# GitHub: https://github.com/settings/developers -> New OAuth App
#   Authorization callback URL: {NEXT_PUBLIC_APP_URL}/api/auth/oauth/github/callback
#     e.g. http://localhost:3000/api/auth/oauth/github/callback for local dev
GITHUB_CLIENT_ID=
GITHUB_CLIENT_SECRET=

# --- Seed / bootstrap ---
# Comma-separated E.164 numbers to seed as admin accounts (role='admin') on
# `npm run db:seed`. Log in with these via the normal OTP flow to reach /admin.
ADMIN_PHONE_NUMBERS="+919999999999"
